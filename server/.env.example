# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Discord: Settings -> Advanced -> Developer Mode on, then right-click your server -> Copy Server ID
GUILD_ID=
# Downtime watchdog (watchdog.py): channel -> Edit Channel -> Integrations -> Webhooks -> Copy Webhook URL
WATCHDOG_WEBHOOK_URL=
# Your own Discord user ID (Developer Mode on, right-click yourself -> Copy User ID); pinged on alerts
WATCHDOG_PING_USER_ID=
# Optional, for /catchup AI summaries. CATCHUP_PROVIDER: "ollama" (free, runs on this machine, nothing
# leaves it), "anthropic" (paid API) or empty = automatic: Anthropic if ANTHROPIC_API_KEY is set, else
# Ollama if its server answers, else /catchup stays off
CATCHUP_PROVIDER=
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# Ollama server; empty = http://127.0.0.1:11434. Only localhost or a loopback/private-network IP is accepted
OLLAMA_URL=
# Ollama model, pulled beforehand (ollama pull llama3.2:3b); empty = llama3.2:3b
OLLAMA_MODEL=
# Optional, Welcome Crew (/crew): minutes between crew pings (5 to 1440; empty = 30) and the local
# hours with no crew ping, as FROM-UNTIL (empty = 22-9; "off" = none)
CREW_PING_MINUTES=
CREW_QUIET_HOURS=
# Optional, Supporter tier: the page /support links to. Only https on ko-fi.com, patreon.com or
# discord.com is accepted; empty = /support says supporting isn't open yet
SUPPORT_URL=
# Optional, monthly Town Hall (first Saturday): the local time, e.g. 12:00 or 7pm (empty = 12:00; "off" = none)
TOWNHALL_TIME=
# Optional, live data for the landing page: "off" stops the bot writing bot/data/site/stats.json (empty = on)
SITE_DATA=
# Optional, the voice line in general (one line while 2+ people are in a public voice channel)
# TONIGHT=off   # turn off the voice line in general
# Optional, the Monkey SMP ping (one line mentioning @SMP Ping in the Monkey SMP channel when 3+ players are on)
# SMP_WATCH=off   # turn it off
# SMP_WATCH_ADDRESS=monkeysmp.lscaturchio.xyz   # host (looked up through SRV) or host:port
# SMP_WATCH_MIN=3   # players needed, 2 to 50
# Optional, quiet rooms (the question of the day and the poll pause after 3 in a row went unanswered)
# QUIET=off   # post the question of the day and the poll every day even when nobody answers
# Optional, for clipcast (consented weekly clips uploaded to the server's YouTube channel). All three
# empty = nothing is uploaded; approved clips are listed in the mod log to post by hand.
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID (type "Desktop app")
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Refresh token for the channel's Google account (scope youtube.upload; add youtube.force-ssl to let
# /clipcast remove delete videos). Treat it like a password
YOUTUBE_REFRESH_TOKEN=
# unlisted (default, review before publishing), private or public
YOUTUBE_PRIVACY=
# Optional, for Twitch links in /creator (go-live posts in the creators channel). Both empty = Twitch
# links are refused with a friendly message; YouTube links need no keys.
# dev.twitch.tv/console -> Applications -> Register Your Application -> Client ID, then New Secret
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional, Monkey SMP (Minecraft bridge). Each part turns on by its own settings; all empty = off.
# The old REALMS_* names (from before the server was renamed) still work when a MONKEY_* one is unset.
# Status panel: the server's host:port as seen from this machine, e.g. 127.0.0.1:25565
MONKEY_ADDRESS=
# Whitelist through /smp link and Discord -> Minecraft chat: the server's RCON (server.properties:
# enable-rcon, rcon.port, rcon.password). Host must be localhost or a loopback/private-network IP;
# empty host = 127.0.0.1, empty port = 25575. No password = these two parts stay off
MONKEY_RCON_HOST=
MONKEY_RCON_PORT=
MONKEY_RCON_PASSWORD=
# Minecraft -> Discord chat: full path of the server's logs/latest.log (only ever opened read-only)
MONKEY_LOG_PATH=
# Optional, for ban appeals through the website (site/appeal). A long random string (16+ characters), e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The SAME value goes in the Vercel project as APPEAL_SECRET; empty = appeals off, /ban sends no appeal text
APPEAL_SECRET=
# Days after a ban before an appeal is read (empty = 7) and days after a denial before the next one (empty = 90)
APPEAL_COOLING_DAYS=
APPEAL_REAPPEAL_DAYS=
# The site's address in the ban DM's appeal and join links, https only (empty = https://discord.lscaturchio.xyz)
SITE_URL=
# Optional, the weekly field notes in the field-notes channel (Sundays 18:00). Each section has
# its own setting; none set = no post. Read only: nothing is written back to any of these.
# Built: the owner's GitHub username; only PUBLIC repos are read, with no token
FIELD_NOTES_GITHUB_USER=
# Heard: full path of SpotifyForge's listening_history.jsonl (its scheduled `history sync` keeps it
# current; Front Desk never reads a Spotify token)
FIELD_NOTES_SPOTIFY_HISTORY=
# Watched: the Letterboxd username; its public RSS feed is read
FIELD_NOTES_LETTERBOXD_USER=
# Played: on/off, the server owner's own game time (empty = on when another section is set)
FIELD_NOTES_PLAYED=
# Optional, Monkey SMP factions (/faction register). The forum's name (empty = the smp-forum in
# layout.py), the names held by last season's champion (comma-separated; a name a letter or two
# away from one is refused too), and the season the registrations count for (empty = 1)
FACTIONS_FORUM=
FACTIONS_RESERVED=
FACTIONS_SEASON=
# Optional, Tebex "pass ending" alerts in the mod channel (docs/TEBEX_WEBHOOK.md). The secret Tebex
# shows for the webhook endpoint (16+ characters); empty = the receiver is off and no port is opened
TEBEX_WEBHOOK_SECRET=
# Where it listens (empty = 127.0.0.1 and 8790). Keep 127.0.0.1 behind a tunnel or reverse proxy
TEBEX_WEBHOOK_HOST=
TEBEX_WEBHOOK_PORT=
