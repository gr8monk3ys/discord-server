# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Discord: Settings -> Advanced -> Developer Mode on, then right-click your server -> Copy Server ID
GUILD_ID=
# Downtime watchdog (watchdog.py): channel -> Edit Channel -> Integrations -> Webhooks -> Copy Webhook URL
WATCHDOG_WEBHOOK_URL=
# Your own Discord user ID (Developer Mode on, right-click yourself -> Copy User ID); pinged on alerts
WATCHDOG_PING_USER_ID=
# Optional, for /catchup AI summaries. CATCHUP_PROVIDER: "ollama" (free, runs on this machine, nothing
# leaves it), "anthropic" (paid API) or empty = automatic: Anthropic if ANTHROPIC_API_KEY is set, else
# Ollama if its server answers, else /catchup stays off
CATCHUP_PROVIDER=
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# Ollama server; empty = http://127.0.0.1:11434. Only localhost or a loopback/private-network IP is accepted
OLLAMA_URL=
# Ollama model, pulled beforehand (ollama pull llama3.2:3b); empty = llama3.2:3b
OLLAMA_MODEL=
# Optional, for clipcast (consented weekly clips uploaded to the server's YouTube channel). All three
# empty = nothing is uploaded; approved clips are listed in the mod log to post by hand.
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID (type "Desktop app")
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Refresh token for the channel's Google account (scope youtube.upload; add youtube.force-ssl to let
# /clipcast remove delete videos). Treat it like a password
YOUTUBE_REFRESH_TOKEN=
# unlisted (default, review before publishing), private or public
YOUTUBE_PRIVACY=
